{
	// Editor + `pnpm run typecheck` view: src, tests, scripts and the bench, no output.
	// Node runs the source with its types stripped and never checks them, so this is the
	// type gate. The example is browser code with its own config (example/tsconfig.json),
	// checked by `pnpm run example:build` (bundle --strict).
	"compilerOptions": {
		"target": "es2024",
		// es2025 for Set.prototype.intersection (src/lib/intersect.ts); nothing in src/
		// needs the DOM lib: the library is runtime-neutral
		"lib": ["es2025"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		"strict": true,
		// noUncheckedIndexedAccess is off: Deno never had it, and the move off Deno
		// changes no code
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,

		// erasable-only TS: what Node's type stripping can run unchanged
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		// imports keep their `.ts` extension in source; tsc rewrites them to `.js` on emit
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,

		"noEmit": true
	},
	"include": ["src", "tests", "scripts", "bench"]
}
